# TODO(G1 1.1 Rishav): confirm app.settleiq.dpdns.org opens from other networks; one ISP still returned NXDOMAIN after the record was added.
# One origin for UI + API: no CORS, cookies just work. Worker and agent-tools have no route here.
app.settleiq.dpdns.org {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8080
	}
}
