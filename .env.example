# Copy to .env for local development. Placeholder values only; never commit real ones.

POSTGRES_DB=
# Owns the schema and runs migrations. In the Postgres image this role is a superuser.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Runtime role created by the first migration: NOSUPERUSER, NOBYPASSRLS, so RLS applies.
APP_DB_PASSWORD=

# Connection strings for running the backend outside Docker.
# Docker Compose builds its own, pointing at the `db` service.
DATABASE_URL=
MIGRATION_DATABASE_URL=

ENVIRONMENT=

# api only: immutable raw-evidence store, mounted from the `raw_evidence` volume in Compose.
RAW_EVIDENCE_DIR=/data/raw-evidence

# api only: where emailed links point, and the only browser origin allowed to send a session.
APP_BASE_URL=http://localhost:5173
# api only: SMTP relay for verification and invitation email. Sign-up cannot finish without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# api only: source connection secrets, named by a source's `env:SOURCE_SECRET_<NAME>` reference.
# Production uses `managed:<NAME>` references instead, rendered from SSM by deploy/deploy.sh.
# For the merchant PostgreSQL read source: a read-only role's connection URL.
SOURCE_SECRET_MERCHANT_DB=
# For the PayPal source: the Sandbox app's `client_id:client_secret` (or JSON with both keys).
# Store the reference `env:SOURCE_SECRET_PAYPAL_SANDBOX` on the source.
SOURCE_SECRET_PAYPAL_SANDBOX=

# Agent services. Each value goes only to the services named here.
# migrate and dispatcher: password for the dispatcher database role. Required by migrations.
DISPATCHER_DB_PASSWORD=
# dispatcher and agent-tools: signs delegated tool tokens. The agent never receives it.
AGENT_TOKEN_SECRET=
# agent only: OpenAI API key and model name. The model is recorded on every run.
LLM_API_KEY=
LLM_MODEL=

# ---------- Production ----------
# Production never reads this file or .env. Put these names in .env.production at the repo root,
# which git ignores, then run `bash infra/push-prod-env.sh` to copy them to SSM Parameter Store.
# The script refuses a value that matches the one in .env, so production stays separate.
# Generate every password and secret with `openssl rand -hex 32`.
#
# ENVIRONMENT=production
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# APP_DB_PASSWORD=
# ACME_EMAIL=
# BUDGET_ALERT_EMAIL=
# DISPATCHER_DB_PASSWORD=
# AGENT_TOKEN_SECRET=
# LLM_API_KEY=
# LLM_MODEL=
# COMPOSE_PROFILES=
# APP_BASE_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
