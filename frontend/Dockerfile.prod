# TODO(G1 1.1 Rishav): owner review of this image; it is live in production.
# TODO(G1 1.11 Suprava): pass VITE_* values as build args if the client needs any; none reach this build.
# Production image: static build served by nginx. Dockerfile runs the local Vite dev server.
FROM node:22-alpine AS build

WORKDIR /srv/app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/app/dist /usr/share/nginx/html

EXPOSE 8080
